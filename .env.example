# Application Configuration
APP_NAME=BotProductFactory
ENVIRONMENT=development
DEBUG=True
HOST=0.0.0.0
PORT=8000
SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-string

# Redis & ARQ Worker
REDIS_URL=redis://localhost:6379/0

# Database (PostgreSQL AsyncPG)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/bot_factory

# WhatsApp Cloud API Configuration
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_permanent_system_user_access_token
WHATSAPP_APP_SECRET=your_meta_app_secret
WHATSAPP_VERIFY_TOKEN=your_custom_webhook_verify_token
WHATSAPP_API_VERSION=v19.0

# Telegram Bot API Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_SECRET_TOKEN=your_custom_telegram_webhook_secret_token

# Chatwoot Live Agent Desk Configuration
CHATWOOT_BASE_URL=https://app.chatwoot.com
CHATWOOT_API_ACCESS_TOKEN=your_chatwoot_user_or_bot_token
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_INBOX_ID=1
CHATWOOT_WEBHOOK_SECRET=your_chatwoot_webhook_secret

# AI Brain & LLM Gateway
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini
AI_CANARY_SECRET=your_ai_canary_secret_salt
